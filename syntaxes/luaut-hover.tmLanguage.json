{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "luaut-hover",
  "scopeName": "source.luaut-hover",
  "comment": "Colours the code block in a luaut hover. That text is not user code: the language server writes it in a fixed format (`const x: T`, `(parameter) n: T`, `declare function f(a: T) -> R`, `type A<T> = ...`), so these rules describe that format exactly. Each name gets the scope the editor's semantic tokens map to for the same thing (a const is variable.other.constant, a parameter variable.parameter, a type parameter entity.name.type.parameter, ...), so a hover reads in the same colours as the code it describes.",
  "patterns": [
    { "include": "#overloads" },
    { "include": "#labelled" },
    { "include": "#declaration" },
    { "include": "#reference" },
    { "include": "#type-body" }
  ],
  "repository": {
    "overloads": {
      "name": "comment.overloads.luaut-hover",
      "match": "\\(\\+[0-9]+ overloads?\\)"
    },
    "labelled": {
      "patterns": [
        {
          "match": "^\\(parameter\\)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "variable.parameter.luaut-hover" } }
        },
        {
          "match": "^\\(property\\)\\s+(?:(readonly)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\??\\s*:\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": { "name": "storage.modifier.luaut-hover" },
            "2": { "name": "entity.name.function.member.luaut-hover" }
          }
        },
        {
          "match": "^\\(property\\)\\s+(?:(readonly)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.luaut-hover" },
            "2": { "name": "variable.other.property.luaut-hover" }
          }
        },
        {
          "match": "^\\(type parameter\\)\\s+(?:(const|infer)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.luaut-hover" },
            "2": { "name": "entity.name.type.parameter.luaut-hover" }
          }
        },
        {
          "match": "^\\((?:global|loop variable)\\)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "variable.other.readwrite.luaut-hover" } }
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.type.luaut-hover" },
            "2": { "name": "entity.name.type.luaut-hover" }
          }
        },
        {
          "match": "\\b(declare)\\s+(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.modifier.luaut-hover" },
            "2": { "name": "storage.type.class.luaut-hover" },
            "3": { "name": "entity.name.type.class.luaut-hover" },
            "4": { "name": "storage.modifier.luaut-hover" },
            "5": { "name": "entity.name.type.class.luaut-hover" }
          }
        },
        {
          "match": "\\b(declare)\\s+(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.luaut-hover" },
            "2": { "name": "storage.type.function.luaut-hover" },
            "3": { "name": "entity.name.function.luaut-hover" }
          }
        },
        {
          "comment": "A binding whose type is a function colours as a function, as it does in the editor.",
          "match": "\\b(const|let|declare)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": { "name": "storage.type.luaut-hover" },
            "2": { "name": "entity.name.function.luaut-hover" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.luaut-hover" },
            "2": { "name": "variable.other.constant.luaut-hover" }
          }
        },
        {
          "match": "\\b(let|declare)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.luaut-hover" },
            "2": { "name": "variable.other.readwrite.luaut-hover" }
          }
        }
      ]
    },
    "reference": {
      "comment": "`name: T` at the start: the hover of a reference.",
      "patterns": [
        {
          "match": "^([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": { "1": { "name": "entity.name.function.luaut-hover" } }
        },
        {
          "match": "^([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "captures": { "1": { "name": "variable.other.readwrite.luaut-hover" } }
        }
      ]
    },
    "type-body": {
      "patterns": [
        { "include": "#overloads" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#constant" },
        { "include": "#keyword" },
        { "include": "#primitive" },
        { "include": "#parameters" },
        { "include": "#object" },
        { "include": "#type-name" },
        { "include": "#operator" }
      ]
    },
    "parameters": {
      "comment": "Inside parentheses a name before `:` is a parameter.",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\??)(?=\\s*:)",
          "captures": {
            "1": { "name": "variable.parameter.luaut-hover" },
            "2": { "name": "keyword.operator.optional.luaut-hover" }
          }
        },
        { "name": "keyword.operator.rest.luaut-hover", "match": "\\.\\.\\." },
        { "include": "#type-body" }
      ]
    },
    "object": {
      "comment": "Inside braces a name before `:` is a property, or a method when its type is a function.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "name": "storage.modifier.luaut-hover", "match": "\\breadonly\\b" },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\??)(?=\\s*:\\s*(?:<[^>]*>\\s*)?\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.luaut-hover" },
            "2": { "name": "keyword.operator.optional.luaut-hover" }
          }
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\??)(?=\\s*:)",
          "captures": {
            "1": { "name": "variable.other.property.luaut-hover" },
            "2": { "name": "keyword.operator.optional.luaut-hover" }
          }
        },
        { "include": "#type-body" }
      ]
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.double.luaut-hover", "match": "\"(?:[^\"\\\\]|\\\\.)*\"" },
        { "name": "string.template.luaut-hover", "match": "`[^`]*`" }
      ]
    },
    "number": {
      "name": "constant.numeric.luaut-hover",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "constant": {
      "name": "constant.language.luaut-hover",
      "match": "\\b(?:true|false|nil)\\b"
    },
    "keyword": {
      "patterns": [
        { "name": "storage.modifier.luaut-hover", "match": "\\b(?:extends|readonly)\\b" },
        { "name": "keyword.operator.expression.luaut-hover", "match": "\\b(?:keyof|typeof|infer|is|asserts|in)\\b" }
      ]
    },
    "primitive": {
      "name": "support.type.primitive.luaut-hover",
      "match": "\\b(?:any|unknown|never|boolean|number|string|thread|buffer)\\b"
    },
    "type-name": {
      "name": "entity.name.type.luaut-hover",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operator": {
      "name": "keyword.operator.luaut-hover",
      "match": "->|[|&?=-]"
    }
  }
}
