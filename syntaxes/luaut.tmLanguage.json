{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "luaut",
  "scopeName": "source.luaut",
  "comment": "Deliberately small: only what the characters alone decide. Names, types, and soft keywords (extends, keyof, infer, typeof, type, declare) depend on context, so the language server colours those from the parser via semantic tokens.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#constant" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.block.luaut", "begin": "--\\[(=*)\\[", "end": "\\]\\1\\]" },
        { "name": "comment.line.double-dash.luaut", "match": "--.*$" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.luaut",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.luaut",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.template.luaut",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#escape" },
            {
              "name": "meta.template.expression.luaut",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.luaut" } },
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.luaut" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "comment": "Code accepts only levelled long strings; a bare [[ is two array brackets.",
          "name": "string.quoted.other.multiline.luaut",
          "begin": "\\[(=+)\\[",
          "end": "\\]\\1\\]"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.luaut",
      "match": "\\\\."
    },
    "number": {
      "name": "constant.numeric.luaut",
      "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b"
    },
    "keyword": {
      "comment": "Exactly the lexer's reserved words.",
      "patterns": [
        {
          "name": "keyword.control.luaut",
          "match": "\\b(if|then|elseif|else|end|for|in|while|do|repeat|until|break|continue|return)\\b"
        },
        { "name": "storage.type.luaut", "match": "\\b(const|let|function)\\b" },
        { "name": "keyword.control.import.luaut", "match": "\\b(import|export|from|as)\\b" },
        { "name": "keyword.operator.word.luaut", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "constant": {
      "name": "constant.language.luaut",
      "match": "\\b(true|false|nil)\\b"
    }
  }
}
