{
    "comments": { "lineComment": "--", "blockComment": ["--[[", "]]"] },
    "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string"] },
        { "open": "`", "close": "`", "notIn": ["string"] }
    ],
    "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"]],
    "indentationRules": {
        "increaseIndentPattern": "^\s*(else|elseif|do|then|repeat|.*\b(function|if|for|while)\b.*)\s*$|[{(\[]\s*$",
        "decreaseIndentPattern": "^\s*(end|else|elseif|until|[}\)\]])"
    },
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
