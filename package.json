{
  "name": "luaut-vscode",
  "displayName": "luaut",
  "description": "luaut language support — diagnostics, hover, completion, go-to-definition",
  "version": "0.2.0",
  "publisher": "uav1010",
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:luaut"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luaut",
        "aliases": [
          "luaut",
          "Luaut"
        ],
        "extensions": [
          ".luaut",
          ".d.luaut"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "luaut-hover",
        "aliases": [
          "luaut-hover"
        ]
      }
    ],
    "grammars": [
      {
        "language": "luaut",
        "scopeName": "source.luaut",
        "path": "./syntaxes/luaut.tmLanguage.json"
      },
      {
        "language": "luaut-hover",
        "scopeName": "source.luaut-hover",
        "path": "./syntaxes/luaut-hover.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "control",
        "description": "A control keyword, coloured like `export` or `return`."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "luaut",
        "scopes": {
          "keyword.control": [
            "keyword.control.luaut"
          ]
        }
      }
    ],
    "configuration": {
      "title": "luaut",
      "properties": {
        "luaut.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a luaut-language-server build (dist/cli.js). Empty uses the one bundled with this extension."
        },
        "luaut.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the luaut output channel."
        }
      }
    },
    "commands": [
      {
        "command": "luaut.restartServer",
        "title": "luaut: Restart Language Server"
      }
    ],
    "configurationDefaults": {
      "[luaut]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "package": "npm run build && vsce package",
    "publish": "npm run build && vsce publish",
    "vscode:prepublish": "npm run build",
    "reinstall": "vsce package --out luaut-vscode.vsix && code --install-extension luaut-vscode.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "luaut-language-server": "^1.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.4",
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Uav3537/luaut-vscode.git"
  },
  "icon": "icon.png"
}
